    given-names: "Aleix"
    email: "aleix.marine@urv.cat"
    affiliation: "Universitat Rovira i Virgili"
repository-code: "https://github.com/URV-teacher/bmde"
url: "https://urv-teacher.github.io/bmde/"
license: GPL-3.0-or-later
keywords:
  - nintendo-ds
  - devkitpro
  - bare-metal
  - development-environment
  - education
