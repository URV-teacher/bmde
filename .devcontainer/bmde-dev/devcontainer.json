// Development environment of the bmde CLI: Python, the tools of `make dev` and Docker, on top of the NDS development
// environment of the BMDE (see .devcontainer/nds/), so the commands of the CLI can be run against the real tools.
// Image: .devcontainer/bmde-dev/Dockerfile, published as aleixmt/bmde-dev.
{
	"name": "BMDE: bmde CLI development",
	"image": "aleixmt/bmde-dev:latest",
	"remoteUser": "bmde",
	"init": true,

	// Graphical programs open their windows in the X server of the host. For VNC, see .devcontainer/nds/devcontainer.json
	"containerEnv": {
		"MODE": "host",
		"DISPLAY": "${localEnv:DISPLAY}"
	},
	"initializeCommand": "xhost +SI:localuser:$(id -un) >/dev/null 2>&1 || true",

	// - Docker daemon of the container (Docker in Docker): the docker backend of the CLI and the integration tests mount
	//   paths of this container in their containers, which a daemon of the host could not see. Its images are kept in
	//   a volume, so they survive rebuilding the container.
	// - The VPN of the URV creates a PPP interface.
	"privileged": true,
	"mounts": [
		"source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind",
		"source=bmde-dev-docker,target=/var/lib/docker,type=volume"
	],
	"runArgs": ["--cap-add=NET_ADMIN", "--device=/dev/ppp"],
	"postStartCommand": "pgrep -x dockerd >/dev/null || sudo setsid dockerd >/tmp/dockerd.log 2>&1 &",

	"postCreateCommand": "git submodule update --init --recursive && make dev",

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.mypy-type-checker",
				"charliermarsh.ruff",
				"editorconfig.editorconfig",
				"tamasfe.even-better-toml",
				"redhat.vscode-yaml",
				"ms-azuretools.vscode-docker",
				"timonwong.shellcheck",
				"aleixmt.nds-arm-assembly-syntax-highlight",
				"ms-vscode.cpptools",
				"ms-vscode.makefile-tools"
			],
			"settings": {
				"python.defaultInterpreterPath": "${containerWorkspaceFolder}/venv/bin/python",
				"[python]": {
					"editor.defaultFormatter": "charliermarsh.ruff",
					"editor.formatOnSave": true,
					"editor.codeActionsOnSave": {
						"source.fixAll": "explicit",
						"source.organizeImports": "explicit"
					}
				}
			}
		}
	}
}
