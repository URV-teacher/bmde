{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/bmde.toml)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(**/.envrc)",
      "Read(**/.pypirc)",
      "Read(**/*.ovpn)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/id_rsa*)",
      "Read(**/id_ecdsa*)",
      "Read(**/id_ed25519*)",
      "Read(~/.ssh/**)",
      "Edit(/bmde.toml)",
      "Edit(**/.env)",
      "Edit(**/.env.*)"
    ]
  }
}
