# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.py]
max_line_length = 120

[*.{yml,yaml,json,toml,cff,hcl}]
indent_size = 4

[.gitmodules]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
max_line_length = 0

[Makefile]
indent_style = tab
